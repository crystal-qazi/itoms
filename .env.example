FLASK_ENV=development
ITOMS_SECRET_KEY=replace-with-a-local-secret
ITOMS_DB_HOST=127.0.0.1
ITOMS_DB_PORT=3306
ITOMS_DB_NAME=itoms_dev
ITOMS_DB_USER=itoms_app
ITOMS_DB_PASSWORD=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ITOMS_TOTP_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Grafana integration: configure a long random shared secret and dedicated service employee.
ITOMS_GRAFANA_WEBHOOK_SECRET=replace-with-long-random-secret
ITOMS_GRAFANA_SERVICE_EMPLOYEE_ID=0

# Optional outbound notification email. Configure exactly one secure mode.
ITOMS_SMTP_HOST=
ITOMS_SMTP_PORT=587
ITOMS_SMTP_USERNAME=
ITOMS_SMTP_PASSWORD=
ITOMS_SMTP_FROM=
ITOMS_SMTP_USE_STARTTLS=true
ITOMS_SMTP_USE_SSL=false
ITOMS_SMTP_TIMEOUT=15
